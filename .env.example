# Copy to .env and adjust. docker-compose.yml reads this for both services.

NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=cardreader
POSTGRES_PASSWORD=cardreader_dev_pw
POSTGRES_DB=cardreader

# --- AI provider ---
# No key = the stub provider runs (empty contact + a warning, zero cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Upload limits ---
MAX_UPLOAD_MB=15

# --- Frontend -> backend wiring (local dev only — see note below) ---
VITE_API_URL=http://localhost:8090
CORS_ORIGIN=http://localhost:3020,https://businesscard.arundopower.com

# NOTE: the values above only apply to the local `cardreader-frontend` dev
# service in docker-compose.yml. The real, publicly-deployed frontend is
# hosted by Lovable at businesscard.arundopower.com, not on this box. Once
# the backend has a public route (api-businesscard.arundopower.com — see
# /opt/docker/reverse-proxy/traefik/dynamic-disabled/businesscard-api.yml.awaiting-dns),
# set VITE_API_URL in the Lovable project's own environment variables to
# that route and trigger a Lovable rebuild — this file does not configure
# Lovable's build.
