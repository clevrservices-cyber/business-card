# Copy to .env and adjust. docker-compose.yml reads this for both services.

NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=cardreader
POSTGRES_PASSWORD=cardreader_dev_pw
POSTGRES_DB=cardreader

# --- AI provider ---
# No key = the stub provider runs (empty contact + a warning, zero cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Upload limits ---
MAX_UPLOAD_MB=15

# --- CORS (local dev only) ---
# In production, frontend and backend share one origin
# (businesscard.arundopower.com, routed by Traefik — see
# /opt/docker/reverse-proxy/traefik/dynamic/businesscard.yml) so no CORS is
# needed there. This only matters when running the frontend dev server
# (different port) against this compose stack's backend locally.
CORS_ORIGIN=http://localhost:3020

# NOTE: VITE_API_URL is intentionally NOT set for the production
# cardreader-frontend service (docker-compose.yml) — same-origin `/api/...`
# calls resolve correctly once Traefik routes them to the backend. Only set
# it if running `bun run dev` locally against a backend on a different port.
