# Copy to backend/.env and adjust.

NODE_ENV=development
PORT=8090

# --- Postgres (host port 5439, see docker-compose.yml) ---
POSTGRES_USER=cardreader
POSTGRES_PASSWORD=cardreader_dev_pw
POSTGRES_DB=cardreader
DATABASE_URL=postgres://cardreader:cardreader_dev_pw@127.0.0.1:5439/cardreader

# --- AI provider ---
# OpenAI key wins if set, then Anthropic, then the zero-cost stub (empty
# contact + a warning) — useful for exercising the rest of the pipeline
# (upload validation, QR, merge, DB) without spend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Upload limits ---
MAX_UPLOAD_MB=15

# --- CORS: the frontend's origin(s), comma-separated, or "*" ---
# Frontend and backend are both self-hosted on the same domain in production
# (businesscard.arundopower.com, routed by Traefik: PathPrefix(/api) here,
# everything else to the frontend — see
# /opt/docker/reverse-proxy/traefik/dynamic/businesscard.yml), so same-origin
# requests don't need CORS at all. This only matters for local dev, where the
# frontend dev server and this API run on different ports.
CORS_ORIGIN=http://localhost:3020
