# Copy to backend/.env and adjust.

NODE_ENV=development
PORT=8090

# --- Postgres (host port 5439, see docker-compose.yml) ---
POSTGRES_USER=cardreader
POSTGRES_PASSWORD=cardreader_dev_pw
POSTGRES_DB=cardreader
DATABASE_URL=postgres://cardreader:cardreader_dev_pw@127.0.0.1:5439/cardreader

# --- AI provider ---
# No key = the stub provider runs (empty contact + a warning, zero cost) — useful for
# exercising the rest of the pipeline (upload validation, QR, merge, DB) without spend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Upload limits ---
MAX_UPLOAD_MB=15

# --- CORS: the frontend's origin (frontend/backend run on different subdomains) ---
CORS_ORIGIN=http://localhost:3020
