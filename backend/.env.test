# Loaded automatically by `bun test` (NODE_ENV=test), on top of the real
# `.env` — Bun loads both, with this file's values winning. Not a real
# credential — only DB-dependent tests (skipped when postgres isn't actually
# running) touch this connection string; the validation-only tests never open it.
DATABASE_URL=postgres://cardreader:cardreader_dev_pw@127.0.0.1:5439/cardreader

# Force the stub AI provider during tests, even though the real `.env` now
# carries a live OPENAI_API_KEY for the running dev server — tests must stay
# hermetic (deterministic, no real API spend, no network dependency), never
# silently exercising a paid provider just because a key happens to be
# configured for local development.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
